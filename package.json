{
  "name": "mugi-tutor",
  "private": true,
  "version": "0.1.0",
  "license": "MIT",
  "type": "module",
  "engines": {
    "node": ">=20"
  },
  "scripts": {
    "dev": "vite",
    "build": "tsc -b && vite build",
    "preview": "vite preview",
    "test": "vitest run",
    "build:mobile": "tsc -p tsconfig.mobile.json && tsc -p tsconfig.worker.json && vite build --config vite.mobile.config.ts",
    "deploy": "npm run build:mobile && wrangler deploy",
    "dev:mobile": "npm run build:mobile && wrangler dev --port 8787",
    "deploy:check": "wrangler deploy --dry-run"
  },
  "dependencies": {
    "@anthropic-ai/sdk": "0.135.0",
    "jose": "6.2.14",
    "kuromoji": "0.1.2",
    "react": "19.3.0",
    "react-dom": "19.3.0",
    "soundtouchjs": "0.3.0"
  },
  "devDependencies": {
    "@types/node": "24.19.1",
    "@types/react": "19.3.0",
    "@types/react-dom": "19.3.0",
    "@vitejs/plugin-react": "6.1.2",
    "jsdom": "30.1.2",
    "typescript": "6.0.3",
    "vite": "8.3.3",
    "vitest": "5.0.3",
    "wrangler": "^4.156.0"
  }
}
